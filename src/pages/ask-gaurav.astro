---
import BaseLayout from '../layouts/BaseLayout.astro';
import AskGaurav from '../components/AskGaurav/AskGaurav.tsx';
---

<BaseLayout title="Ask-Gaurav — in-browser assistant" description="Ask a real language model, running locally in your browser, about Gaurav or anything AI.">
  <section class="ask-intro" data-reveal>
    <h1>Ask-Gaurav</h1>
    <p class="muted">
      A real language model runs here — locally, in your browser. Grounded questions about Gaurav get
      answers with citations from this site (`retrieval-augmented generation`); general AI questions get
      straight answers. No server, no API keys, no data leaving your device.
    </p>
  </section>
  <AskGaurav client:only="react" />
</BaseLayout>
