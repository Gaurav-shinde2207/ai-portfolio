---
import BaseLayout from '../layouts/BaseLayout.astro';
import SelfTest from '../components/AskGaurav/SelfTest';
---

<BaseLayout title="Self-test · Gaurav Shinde" description="In-browser eval harness: 20 questions run through the live RAG + local LLM pipeline and scored automatically.">
  <h1>Self-test</h1>
  <p class="muted">
    This page is the site's own quality gate: 20 curated questions (12 grounded, 8 general-AI) run
    through the same pipeline the Ask-Gaurav assistant uses, then each answer is scored against
    expected keywords. Target: ≥ 80% pass rate.
  </p>
  <SelfTest client:only="react" />
</BaseLayout>
