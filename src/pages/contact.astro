---
import resume from '../data/resume.json';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — Gaurav Shashikant Shinde" description="One step: email me.">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl" style="font-family: var(--font-mono);">Contact</h1>
    <p class="mt-3">One step — write me an email:</p>
    <p class="mt-4 text-xl">
      <a class="link" href={`mailto:${resume.email}`}>{resume.email}</a>
    </p>
    <div class="mt-6 flex gap-4">
    <a class="link" href={`https://github.com/${resume.github}`} rel="noopener">GitHub</a>
      <a class="link" href={resume.linkedin} rel="noopener">LinkedIn</a>
      <a class="link" href="/resume/">Résumé</a>
    </div>
  </section>
</BaseLayout>
