---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
---

<BaseLayout title="Gaurav Shashikant Shinde — AI Engineer">
  <Hero />
  <main class="max-w-3xl mx-auto px-6 py-20">
    <ScrollReveal>
      <h2 class="text-2xl" style="font-family: var(--font-mono);">Building in-browser AI systems.</h2>
      <p class="mt-3" style="color: var(--muted);">
        This site ships with a local language model — retrieval, embeddings and
        inference all run in your browser, no server involved. Ask it below.
      </p>
    </ScrollReveal>
  </main>
</BaseLayout>
