---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, blurb, metrics, stack, demoUrl, repoUrl } = entry.data;
---

<BaseLayout title={`${title} — Gaurav Shashikant Shinde`} description={blurb}>
  <article class="prose-custom max-w-3xl mx-auto px-6 py-16">
    <p><a href="/projects/">← All projects</a></p>
    <h1 class="text-3xl mt-4" style="font-family: var(--font-mono);">{title}</h1>
    <p class="mt-3 text-lg" style="color: var(--muted);">{blurb}</p>
    {metrics?.length ? (
      <ul class="mt-5 flex flex-wrap gap-2">
        {metrics.map((m) => (
          <li class="badge">{m.label}: {m.value}</li>
        ))}
      </ul>
    ) : null}
    {stack?.length ? (
      <p class="mt-3 text-sm" style="color: var(--muted); font-family: var(--font-mono);">{stack.join(' · ')}</p>
    ) : null}
    {(demoUrl?.length || repoUrl?.length) ? (
      <div class="mt-5 flex gap-4">
        {demoUrl?.length ? <a class="link" href={demoUrl} rel="noopener">Live demo</a> : null}
        {repoUrl?.length ? <a class="link" href={repoUrl} rel="noopener">Source on GitHub</a> : null}
      </div>
    ) : null}
    <div class="case-study mt-10" id="intro">
      <Content />
    </div>
  </article>
</BaseLayout>
