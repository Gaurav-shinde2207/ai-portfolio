---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = await getCollection('projects');
const sorted = projects.sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout title="Projects — Gaurav Shashikant Shinde" description="Case studies: in-browser AI systems, animation pipelines, engineering work.">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <h1 class="text-3xl" style="font-family: var(--font-mono);">Projects</h1>
    <p class="mt-2" style="color: var(--muted);">Everything here is real work, with live demos and source where they exist.</p>
    <div class="mt-10 grid gap-8">
      {sorted.map((entry) => (
        <article class="card">
          <h2 class="text-xl">
            <a href={`/projects/${entry.id}/`}>{entry.data.title}</a>
          </h2>
          <p class="mt-2" style="color: var(--muted);">{entry.data.blurb}</p>
          {entry.data.metrics?.length ? (
            <ul class="mt-3 flex flex-wrap gap-2">
              {entry.data.metrics.map((m) => (
                <li class="badge">{m.label}: {m.value}</li>
              ))}
            </ul>
          ) : null}
          {entry.data.stack?.length ? (
            <p class="mt-3 text-sm" style="color: var(--muted); font-family: var(--font-mono);">{entry.data.stack.join(' · ')}</p>
          ) : null}
          <div class="mt-4 flex gap-4">
            {entry.data.demoUrl && entry.data.demoUrl.length > 0 ? (
              <a class="link" href={entry.data.demoUrl}>Live demo</a>
            ) : null}
            {entry.data.repoUrl && entry.data.repoUrl.length > 0 ? (
              <a class="link" href={entry.data.repoUrl}>GitHub</a>
            ) : null}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
