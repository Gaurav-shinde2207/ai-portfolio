---
import '../styles/global.css';

type Props = {
  title: string;
  description?: string;
};

const { title, description = 'Gaurav Shashikant Shinde — AI Engineer' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const links = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
  { href: '/resume/', label: 'Résumé' },
  { href: '/contact/', label: 'Contact' },
];
const isActive = (href: string) =>
  href === '/' ? path === '' : path === href.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased" style="background-color: var(--bg); color: var(--text);">
    <header class="px-6 py-4" style="font-family: var(--font-mono);">
      <a href="/">Gaurav Shashikant Shinde</a>
      <span style="color: var(--muted);"> · </span>
      <a href="mailto:shindegaurav2201@gmail.com">shindegaurav2201@gmail.com</a>
    </header>

    <nav class="site-nav-left site-nav hidden lg:flex" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      {/*
        "Ask-Gaurav" route ships in Task 8; until then this item is
        pointer-disabled so it cannot 404 users.
      */}
      <span class="nav-disabled" aria-disabled="true" title="Ships with Task 8">Ask-Gaurav</span>
    </nav>
    <nav class="site-nav flex flex-wrap gap-4 px-6 py-2 lg:hidden" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <span class="nav-disabled" aria-disabled="true">Ask-Gaurav</span>
    </nav>

    <main class="layout-main px-6">
      <slot />
    </main>
    <footer class="layout-main px-6 py-8" style="color: var(--muted); font-family: var(--font-mono);">
      © 2026 Gaurav Shashikant Shinde
    </footer>
  </body>
</html>
